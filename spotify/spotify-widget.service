[Unit]
Description=Fetch Spotify now-playing track and write it to a static JSON file
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/spotify-widget.env
ExecStart=/usr/bin/python3 /opt/spotify-widget/spotify_now_playing.py

# Run as the same user nginx uses, so it already owns the output directory
User=www-data
Group=www-data

# Light sandboxing — restricts what the script can touch
ReadWritePaths=/var/www/nikita.sh
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
