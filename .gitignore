*.pyc
.venv/
venv/

# Local secrets. spotify/spotify-widget.env is a committed *template*
# (placeholder values only) — real secrets live in /etc/spotify-widget.env
# on the VPS, never in this repo.
*.env
!spotify/spotify-widget.env

# Claude Code local session state (personal, not shared)
.claude/settings.local.json
