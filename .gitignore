.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/
*.swp
*.swo
*~

# Node — scripts/build.mjs has zero dependencies today (no package.json),
# but keep this ready in case tooling grows.
node_modules/
npm-debug.log*

# Python — spotify/get_refresh_token.py, spotify_now_playing.py
