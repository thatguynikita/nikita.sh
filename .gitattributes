# Normalize line endings to LF in the working tree on every platform.
#
# scripts/build.mjs always writes LF. Without this, a Windows checkout
# with core.autocrlf=true converts the committed files to CRLF, every
# build rewrites them back to LF, and `git status` is permanently dirty —
# which fails CI's drift check with a message about hand-edited
# GENERATED:* blocks that has nothing to do with the actual cause.
* text=auto eol=lf

# Binary assets — never convert, never diff as text.
*.png binary
*.ico binary
*.gif binary
*.jpg binary
*.jpeg binary
*.webp binary
*.woff binary
*.woff2 binary
